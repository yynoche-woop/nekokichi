---
import '../styles/global.css';
import { faceSvg, NEKOKICHI } from '../data/cat-art';
import { sandSvg, sandGround } from '../data/splat';

interface Props {
  title: string;
  description: string;
  /** 構造化データ(JSON-LD)。記事ページなどで渡す */
  jsonld?: object;
}
const { title, description, jsonld } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const d = new Date(Date.now() + 9 * 3600 * 1000); // 日本時間のビルド日
const GA_ID = 'G-52E7ZV9WTT'; // GA4「ネコキチ猫吉 (nekokichi.net)」プロパティ(アカウント「アメショの森」)
const issueDate = `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
// サイト内リンクはすべて "/..." で書く(GitHub Pages のサブパス公開中は scripts/base-links.mjs がビルド後に付け替える)
const nav = [
  { href: '/breeds/', label: '猫種図鑑' },
  { href: '/columns/#kensho', label: 'ウワサ検証' },
  { href: '/columns/#jitsuyo', label: '暮らし・健康' },
  { href: '/tools/', label: 'ツール' },
  { href: '/tools/match/', label: '猫種診断' },
  { href: '/tools/seimei/', label: '猫の姓名判断' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.url.pathname === base ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ネコキチ猫吉" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1c1629" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=M+PLUS+1p:wght@500;700;800&family=Reggae+One&display=swap" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      // 本番ドメインだけ計測する(ローカル確認のアクセスでデータを汚さない)
      if (location.hostname === 'nekokichi.net') gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a href="/" class="brand" id="brand" aria-label="ネコキチ猫吉 トップへ">
          <span class="logo-sand" set:html={sandSvg(3, ['#e6ff2e', '#6c3cff'])} />
          <span class="logo-face">
            <span class="face-calm" set:html={faceSvg(NEKOKICHI, undefined, true)} />
            <span class="face-wow" set:html={faceSvg({ ...NEKOKICHI, expr: 'wow' }, undefined, true)} />
            <span class="bikkuri" aria-hidden="true">!?</span>
          </span>
          <span><b>ネコキチ猫吉</b><small>猫好きは、結局ぜんぶの猫が好き。</small></span>
        </a>
        <p class="issue">{issueDate}更新・編集長:猫吉<span class="price">砂かけ注意</span></p>
      </div>
      <nav class="wrap nav" aria-label="サイト内のコーナー">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>
    <div class="tape" aria-hidden="true"><div class="tape-track">{[0, 1].map(() => ['ネコキチ猫吉', '猫好きは結局ぜんぶの猫が好き', 'NEKOKICHI', '砂かけ注意', 'ウワサ検証中', 'NEKOKICHI'].map((t) => <span>{t}</span>))}</div></div>
    <script>
      // 編集長を押すと「!?」とびっくりしてからトップへ(動きを減らす設定・別タブで開く操作では普通のリンク)
      const brand = document.getElementById('brand') as HTMLAnchorElement;
      brand.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        e.preventDefault();
        brand.classList.add('startled');
        setTimeout(() => {
          if (location.pathname === new URL(brand.href).pathname) {
            brand.classList.remove('startled');
            scrollTo({ top: 0, behavior: 'smooth' });
          } else location.href = brand.href;
        }, 600);
      });
      addEventListener('pageshow', () => brand.classList.remove('startled'));

      // 見えたら「ざっ」と出る
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.pop-in').forEach((el) => io.observe(el));

      // 何もないところをタップすると、猫が後ろ足で砂をかけたように色つきの猫砂が飛ぶ
      const COLORS = ['#e6ff2e', '#6c3cff', '#16e0b0', '#ff3ea5', '#e9d6b0'];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let flip = 1;
      document.addEventListener('click', (e) => {
        if (reduce || (e.target as Element).closest('a, button, input, label, select, textarea, .spot')) return;
        if (getSelection()?.toString()) return;
        kick(e.pageX, e.pageY, (flip = -flip));
      });
      (window as any).nkKick = kick;
      function kick(x: number, y: number, dir: number, count = 40, power = 1) {
        count = Math.round(count * 1.6);
        const color = COLORS[Math.floor(Math.random() * 4)];
        for (let i = 0; i < count; i++) {
          const g = document.createElement('span');
          g.className = 'grain';
          const size = 2.5 + Math.random() * 4;
          g.style.width = `${size * (Math.random() < .5 ? 1.6 : 1)}px`;
          g.style.height = `${size}px`;
          g.style.left = `${x}px`;
          g.style.top = `${y}px`;
          g.style.background = Math.random() < .75 ? color : COLORS[4];
          document.body.appendChild(g);
          const vx = dir * (60 + Math.random() * 260) * power, vy = -(160 + Math.random() * 260) * (power > 1 ? .8 : 1);
          const t = 700 + Math.random() * 500;
          const frames: Keyframe[] = [];
          for (let k = 0; k <= 10; k++) {
            const s = (k / 10) * (t / 1000);
            frames.push({ translate: `${vx * s}px ${vy * s + 900 * s * s}px`, rotate: `${k * 40 * dir}deg`, opacity: k < 8 ? 1 : 1 - (k - 7) / 3 });
          }
          g.animate(frames, { duration: t, easing: 'linear', fill: 'forwards' }).onfinish = () => g.remove();
        }
      }
    </script>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <svg class="ground" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true"><path d={sandGround(11)} fill="#e9d6b0" /></svg>
      <div class="wrap">
        <p><b>ネコキチ猫吉</b> 〜猫好きは、結局ぜんぶの猫が好き〜</p>
        <p>雑種もブランド猫も、短毛も長毛も。猫のウワサを編集部が全力で(そして少しだけ真面目に)検証し、暮らしと健康の「目安」をまとめる猫の総合誌です。</p>
        <p>性格や体の特徴には個体差があります。健康について気になることがあるときは、動物病院にご相談ください。</p>
        <p><a href="/about/">このサイトについて</a> ・ <a href="/columns/">記事一覧</a> ・ <a href="/breeds/">猫種図鑑</a> ・ <a href="/tools/">ツール</a></p>
        <p>© {new Date().getFullYear()} ネコキチ猫吉</p>
      </div>
    </footer>
  </body>
</html>
