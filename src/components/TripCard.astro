---
// 猫の旅の記事の頭に出す「旅のカード」:イラスト(記事の顔)・東京からの位置の地図・小さな現地写真・Googleマップ
import type { Column } from '../lib';
import { japanMapSvg, worldMapSvg } from '../data/trip-map';
import { tripSceneSvg } from '../data/trip-scene';
import { bodySvg } from '../data/cat-art';

interface Props {
  entry: Column;
}
const { entry } = Astro.props;
const d = entry.data;
const t = d.trip!;
const name = d.title.replace(/[::|｜].*$/, '');
const pin = { lat: t.lat, lng: t.lng, label: name.replace(/[((].*$/, '') };
const map = t.region === 'japan' ? japanMapSvg([pin], { title: `東京と${name}の位置` }) : worldMapSvg([pin], { title: `東京と${name}の位置`, labels: false });
const gmap = `https://maps.google.com/maps?q=${encodeURIComponent(t.mapQuery)}&ll=${t.lat},${t.lng}&z=${t.region === 'japan' ? 13 : 14}&hl=ja&output=embed`;
const scene = tripSceneSvg(t.scene, d.art, name, entry.id.length);
// 写真の横:カメラを抱えたハチワレ(サイトの絵柄。キャラクターの模倣はしない)
const camCat = bodySvg({ coat: 'white', pattern: 'solid', eye: 'gold', ears: 'normal', hair: 'short', expr: 'normal' }, 'カメラを抱えた白猫').replace(/<\/svg>\s*$/, `<g stroke="#1c1629" stroke-width="5" stroke-linejoin="round"><path d="M40 150 Q110 200 180 150" fill="none" stroke="#ff3ea5" stroke-width="6"/><rect x="52" y="172" width="116" height="74" rx="12" fill="#2a2433"/><rect x="52" y="172" width="116" height="20" rx="8" fill="#c9c2b3"/><rect x="70" y="160" width="30" height="16" rx="4" fill="#2a2433"/><circle cx="112" cy="214" r="28" fill="#c9c2b3"/><circle cx="112" cy="214" r="18" fill="#2a2433"/><circle cx="112" cy="214" r="9" fill="#6fd3ff" stroke-width="3"/><circle cx="107" cy="209" r="3" fill="#fff" stroke="none"/><rect x="142" y="178" width="16" height="9" rx="2" fill="#e6ff2e" stroke-width="3"/><ellipse cx="54" cy="228" rx="15" ry="12" fill="#fff"/><ellipse cx="166" cy="228" rx="15" ry="12" fill="#fff"/></g></svg>`);
---
<section class="trip" aria-label="旅のデータ">
  <div class="trip-row">
    <figure class="trip-hero"><Fragment set:html={scene} /></figure>
    <div class="trip-info">
      <dl class="trip-facts">
        <dt>場所</dt><dd>{t.place}</dd>
      </dl>
      {t.photo && (
        <div class="trip-photo-row">
          <figure class="trip-photo">
            <img src={t.photo.src} alt={t.photo.alt} width="480" height="320" loading="lazy" decoding="async" />
            <figcaption>現地の写真:<a href={t.photo.url} target="_blank" rel="noopener">{t.photo.author}</a>({t.photo.license})</figcaption>
          </figure>
          <span class="trip-camcat" set:html={camCat} />
        </div>
      )}
    </div>
  </div>
  <div class="trip-row trip-maps">
    <div class="trip-map"><Fragment set:html={map} /></div>
    <div class="trip-gmap">
      <iframe src={gmap} title={`${name}のGoogleマップ`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .trip { display: grid; gap: 14px; margin: 18px 0 26px; }
  .trip-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
  .trip-hero { margin: 0; border: 3px solid var(--k); box-shadow: var(--shadow); background: var(--white); align-self: start; }
  .trip-hero :global(svg) { display: block; width: 100%; height: auto; }
  .trip-info { display: grid; align-content: start; gap: 10px; padding: 4px 6px 0 14px; }
  .trip-photo-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 6px; }
  .trip-camcat { flex: 0 0 auto; width: 104px; }
  .trip-camcat :global(svg) { display: block; width: 100%; height: auto; }
  .trip-facts { margin: 0; display: grid; gap: 4px; font-size: .92rem; }
  .trip-facts dt { font-weight: 900; background: var(--k); color: var(--white); padding: 2px 8px; width: fit-content; }
  .trip-facts dd { margin: 0 0 6px; line-height: 1.7; }
  .trip-photo { margin: 0; flex: 1 1 auto; max-width: 220px; border: 2px solid var(--k); background: var(--white); }
  .trip-photo img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .trip-photo figcaption { font-size: .66rem; padding: 3px 6px; color: var(--gray); line-height: 1.4; }
  .trip-map { border: 3px solid var(--k); background: var(--blue-soft); display: grid; align-items: center; }
  .trip-map :global(svg) { display: block; width: 100%; height: 100%; max-height: 100%; }
  .trip-gmap { border: 3px solid var(--k); background: var(--blue-soft); min-height: 260px; }
  .trip-gmap iframe { display: block; width: 100%; height: 100%; min-height: 260px; border: 0; }
  @media (max-width: 700px) {
    .trip-row { grid-template-columns: 1fr; }
    .trip-gmap, .trip-gmap iframe { min-height: 280px; }
  }
</style>
