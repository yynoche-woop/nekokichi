---
// 猫の旅:泊まるならこの宿(楽天トラベルのアフィリエイト。旅先ごとにいちばんおしゃれな1軒)
// <template> で出し、ビルド後に scripts/stay-move.mjs が本文の「モデルコース」の直前へ移す。記事に1か所だけ。
// ボタンに「楽天トラベル」とあるのでPR表記は付けない(横田さん 2026-10-04)。写真は楽天トラベルの宿の画像を、楽天の画像サーバーで 640px に縮めて表示。見た目は global.css の .stay
import type { Column } from '../lib';

interface Props {
  entry: Column;
}
const { entry } = Astro.props;
const s = entry.data.trip?.stay;
const AFF = '57ed04be.8b7052f1.57ed04bf.f902b143'; // 楽天アフィリエイト(アカウント共通のID)
const href = s ? `https://hb.afl.rakuten.co.jp/hgc/${AFF}/?pc=${encodeURIComponent(s.url)}&m=${encodeURIComponent(s.url)}` : '';
const no = s?.url.match(/HOTEL\/(\d+)/)?.[1];
const img = no ? `https://trvimg.r10s.jp/share/HOTEL/${no}/${no}.jpg?fit=inside%7C640:640` : '';
const place = entry.data.title.replace(/[::|｜(（].*$/, '');
---
{s && (
  <template data-stay>
    <aside class="stay" aria-label="泊まるならこの宿">
      {img && <a class="stay-photo" href={href} target="_blank" rel="sponsored noopener"><img src={img} alt={`${s.name}の写真`} width="640" height="427" loading="lazy" decoding="async" /></a>}
      <div class="stay-body">
        <p class="stay-kicker">{place}の旅、泊まるならここ</p>
        <p class="stay-name">{s.name}</p>
        <p class="stay-why">{s.why}</p>
        {s.access && <p class="stay-access">{s.access}</p>}
        <a class="stay-btn" href={href} target="_blank" rel="sponsored noopener">楽天トラベルで空室・料金を見る</a>
        {img && <p class="stay-credit">写真:楽天トラベル</p>}
      </div>
    </aside>
  </template>
)}
