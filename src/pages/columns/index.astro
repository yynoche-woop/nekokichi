---
import Base from '../../layouts/Base.astro';
import ColumnList from '../../components/ColumnList.astro';
import { getColumns } from '../../lib';

const all = await getColumns();
const shuusei = all.filter((c) => c.data.category === 'shuusei');
const jitsuyo = all.filter((c) => c.data.category === 'jitsuyo');
---
<Base title="記事一覧|ネコキチ猫吉" description="猫の習性事典と、暮らし・健康の実用記事の一覧。箱に入る理由、ゴロゴロのしくみ、三毛猫のオスが少ない遺伝の理由から、食べてはいけないもの・室温・受診の目安まで。">
  <nav class="crumb"><a href="/">トップ</a> › 記事一覧</nav>
  <div class="band"><span class="no">記事</span><h1>記事一覧</h1></div>
  <p class="lede">猫のしぐさや体のふしぎを、研究や獣医師の解説をもとに1項目ずつまとめた「猫の習性事典」と、暮らし・健康の実用記事です。どの猫種にも共通すること、猫種や年齢で変わることを分けて書いています。</p>
  <h2 class="sub-band" id="shuusei"><span id="kensho"></span>猫の習性事典</h2>
  <ColumnList items={shuusei} />
  <h2 class="sub-band" id="jitsuyo">暮らし・健康</h2>
  <ColumnList items={jitsuyo} />
</Base>
