---
// 猫の旅コーナー:猫に会える旅先を、日本地図・世界地図(どちらも東京が基準)と一覧で見せる
import Base from '../../layouts/Base.astro';
import { getColumns } from '../../lib';
import { tripSceneSvg } from '../../data/trip-scene';
import { faceSvg } from '../../data/cat-art';
import { japanMapSvg, worldMapSvg, kmFromTokyo } from '../../data/trip-map';

const all = await getColumns();
const specials = all.filter((c) => c.data.category === 'tabi' && !c.data.trip); // 地図のない特集(猫の宿など)
const trips = all.filter((c) => c.data.category === 'tabi' && c.data.trip).sort((a, b) => kmFromTokyo(a.data.trip!) - kmFromTokyo(b.data.trip!));
const japan = trips.filter((c) => c.data.trip!.region === 'japan');
const world = trips.filter((c) => c.data.trip!.region === 'world');
const short = (t: string) => t.replace(/[::|｜].*$/, '');
const pins = (list: typeof trips, from: number) => list.map((c, i) => ({ lat: c.data.trip!.lat, lng: c.data.trip!.lng, n: from + i, href: `/columns/${c.id}/`, label: short(c.data.title) }));
const jmap = japanMapSvg(pins(japan, 1), { title: '日本の猫の旅先の地図', labels: false, w: 640, h: 560 });
const wmap = worldMapSvg(pins(world, japan.length + 1), { title: '世界の猫の旅先の地図', labels: false });
---
<Base title="猫の旅:猫に会える旅先(日本・世界)|ネコキチ猫吉" description="猫島・招き猫のお寺・猫の駅長から、イスタンブールやローマの猫まで。猫に会える日本と世界の旅先を、東京からの位置がわかる地図と行き方の目安つきでまとめました。">
  <nav class="crumb"><a href="/">トップ</a> › 猫の旅</nav>
  <div class="band"><span class="no">TABI</span><h1>猫の旅</h1></div>
  <p class="lede">猫島、招き猫のお寺、猫の駅長、遺跡に暮らす猫たち。猫に会える旅先を、東京からの位置と行き方の目安つきでまとめました。どこも猫たちの暮らしの場所です。エサやりのルールは土地ごとに違うので、各ページの「マナー」を読んでから出かけてください。</p>

  {specials.length > 0 && (
    <>
      <h2 class="sub-band" id="tokushu">特集</h2>
      <ul class="tabi-specials">
        {specials.map((c) => (
          <li><a class="tabi-special" href={`/columns/${c.id}/`}><span class="tabi-sp-face" set:html={faceSvg(c.data.art)} /><span><b>{c.data.title}</b><small>{c.data.description}</small></span></a></li>
        ))}
      </ul>
    </>
  )}

  <h2 class="sub-band" id="japan">日本の猫の旅({japan.length}か所)</h2>
  <div class="tabi-map"><Fragment set:html={jmap} /></div>
  <ol class="tabi-list">
    {japan.map((c, i) => (
      <li>
        <a class="tabi-card" href={`/columns/${c.id}/`}>
          <span class="tabi-n">{i + 1}</span>
          <span class="tabi-scene" set:html={tripSceneSvg(c.data.trip!.scene, c.data.art, short(c.data.title), c.id.length)} />
          <span class="tabi-body">
            <b>{short(c.data.title)}</b>
            <small>{c.data.trip!.place}・東京から約{kmFromTokyo(c.data.trip!).toLocaleString()}km</small>
            <span>{c.data.trip!.access}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <h2 class="sub-band" id="world">世界の猫の旅({world.length}か所)</h2>
  <div class="tabi-map"><Fragment set:html={wmap} /></div>
  <ol class="tabi-list" start={japan.length + 1}>
    {world.map((c, i) => (
      <li>
        <a class="tabi-card" href={`/columns/${c.id}/`}>
          <span class="tabi-n">{japan.length + i + 1}</span>
          <span class="tabi-scene" set:html={tripSceneSvg(c.data.trip!.scene, c.data.art, short(c.data.title), c.id.length)} />
          <span class="tabi-body">
            <b>{short(c.data.title)}</b>
            <small>{c.data.trip!.place}・東京から約{kmFromTokyo(c.data.trip!).toLocaleString()}km</small>
            <span>{c.data.trip!.access}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  {trips.some((c) => c.data.trip!.time) && (
    <>
      <h2 class="sub-band" id="hikaku">15か所の比較表</h2>
      <p class="lede">東京からの近さ順。所要時間は乗り継ぎを含む目安で、便数や季節で変わります。エサやりのルールは2026年10月時点の公式情報や現地の案内によるものです。</p>
      <div class="tabi-table">
        <table>
          <thead><tr><th>旅先</th><th>東京から</th><th>船</th><th>エサやり</th></tr></thead>
          <tbody>
            {trips.map((c) => (
              <tr>
                <td><a href={`/columns/${c.id}/`}>{short(c.data.title)}</a></td>
                <td>{c.data.trip!.time ?? '—'}<br /><small>約{kmFromTokyo(c.data.trip!).toLocaleString()}km</small></td>
                <td>{c.data.trip!.ship ? 'あり' : 'なし'}</td>
                <td>{c.data.trip!.feed ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
  <p class="small">地図の地形は Natural Earth のデータをもとに描いています。距離は東京駅からの直線距離の目安です。</p>
  <p class="back"><a class="btn" href="/columns/">記事一覧へ</a> <a class="btn btn-pink" href="/">トップへ</a></p>
</Base>

<style>
  .tabi-specials { list-style: none; padding: 0; margin: 10px 0 24px; display: grid; gap: 12px; }
  .tabi-special { display: grid; grid-template-columns: 90px 1fr; gap: 14px; align-items: center; padding: 14px; background: var(--paper); color: var(--k); text-decoration: none; border: 3px solid var(--k); box-shadow: 6px 6px 0 var(--pink); }
  .tabi-special:hover { color: var(--k); translate: 0 -3px; }
  .tabi-special b { display: block; font-family: var(--font-head); font-size: 1.15rem; line-height: 1.4; }
  .tabi-special small { display: block; margin-top: 4px; font-size: .84rem; line-height: 1.6; }
  .tabi-map { border: 3px solid var(--k); background: var(--white); box-shadow: var(--shadow); margin: 10px 0 18px; }
  .tabi-map :global(svg) { display: block; width: 100%; height: auto; }
  .tabi-map :global(a:hover path) { fill: var(--pink); }
  .tabi-list { list-style: none; padding: 0; margin: 0 0 28px; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .tabi-card { position: relative; display: grid; grid-template-rows: auto 1fr; gap: 10px; align-content: start; height: 100%; padding: 12px; background: var(--paper); color: var(--k); text-decoration: none; border: 3px solid var(--k); box-shadow: var(--shadow); transition: translate .15s; }
  .tabi-card:hover { translate: 0 -3px; color: var(--k); }
  .tabi-n { position: absolute; left: -8px; top: -10px; width: 30px; height: 30px; z-index: 1; display: grid; place-items: center; background: var(--yellow); border: 3px solid var(--k); border-radius: 50%; font-family: var(--font-latin); font-weight: 900; }
  .tabi-scene { display: block; margin: -12px -12px 0; border-bottom: 3px solid var(--k); overflow: hidden; }
  .tabi-scene :global(svg) { display: block; width: 100%; height: auto; }
  .tabi-scene :global(svg > rect:last-child) { display: none; }
  .tabi-body { display: grid; gap: 3px; }
  .tabi-body b { font-family: var(--font-head); font-size: 1.08rem; line-height: 1.35; }
  .tabi-body small { font-size: .78rem; font-weight: 700; color: var(--gray); }
  .tabi-body span { font-size: .84rem; line-height: 1.6; }
  .tabi-table { background: var(--paper); color: var(--k); border: 3px solid var(--k); box-shadow: var(--shadow); margin: 10px 0 24px; overflow-x: auto; }
  .tabi-table table { width: 100%; border-collapse: collapse; font-size: .86rem; }
  @media (max-width: 520px) { .tabi-table table { font-size: .76rem; } .tabi-table th, .tabi-table td { padding: 5px 5px; } }
  .tabi-table th { background: var(--k); color: var(--white); text-align: left; padding: 6px 8px; white-space: nowrap; }
  .tabi-table td { padding: 6px 8px; border-top: 1px solid var(--hair); vertical-align: top; line-height: 1.5; }
  .tabi-table td small { color: var(--gray); }
</style>
