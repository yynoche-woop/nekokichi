---
import Base from '../layouts/Base.astro';
import ColumnList from '../components/ColumnList.astro';
import { getColumns } from '../lib';
import { BREEDS } from '../data/breeds';
import { TOOLS } from '../data/tools';
import { faceSvg, bodySvg, NEKOKICHI } from '../data/cat-art';
import type { Art } from '../data/art-schema';

const all = await getColumns();
const kensho = all.filter((c) => c.data.category === 'kensho');
const jitsuyo = all.filter((c) => c.data.category === 'jitsuyo');
const rumors = kensho.slice(0, 6);
const pickup = ['mix', 'scottish-fold', 'munchkin', 'ragdoll', 'maine-coon', 'british-shorthair', 'american-shorthair', 'russian-blue']
  .map((s) => BREEDS.find((b) => b.slug === s))
  .filter((b) => b !== undefined);

// 一面は「ねこの庭」:いろんな猫が、座布団・段ボール・芝生に集まっている。真ん中に編集長・猫吉(おすわり)
type Spot = { a: Art; x: number; y: number; w: number; prop?: 'zabu' | 'box'; label: string; body?: boolean };
const SCENE: Spot[] = [
  { a: { coat: 'black', pattern: 'solid', eye: 'gold', ears: 'normal', hair: 'short', expr: 'normal' }, x: 6, y: 14, w: 17, label: '黒猫' },
  { a: { coat: 'blue', pattern: 'solid', eye: 'copper', ears: 'fold', hair: 'short', expr: 'normal' }, x: 70, y: 12, w: 16, label: 'スコティッシュフォールド' },
  { a: { coat: 'white', pattern: 'calico', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' }, x: 4, y: 50, w: 21, prop: 'zabu', label: '三毛猫' },
  { a: { coat: 'white', pattern: 'tuxedo', eye: 'green', ears: 'normal', hair: 'short', expr: 'wow' }, x: 22, y: 68, w: 19, prop: 'box', label: 'ハチワレ' },
  { a: NEKOKICHI, x: 38, y: 22, w: 25, body: true, label: '編集長の猫吉' },
  { a: { coat: 'seal', pattern: 'point', eye: 'blue', ears: 'normal', hair: 'long', expr: 'normal' }, x: 66, y: 50, w: 22, prop: 'zabu', label: 'ラグドール' },
  { a: { coat: 'red', pattern: 'tabby', eye: 'gold', ears: 'normal', hair: 'short', expr: 'sleepy' }, x: 84, y: 34, w: 14, label: '寝ている茶トラ' },
  { a: { coat: 'silver', pattern: 'classic', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' }, x: 62, y: 76, w: 17, label: 'シルバータビー' },
];
const boss = bodySvg(NEKOKICHI, '編集長の猫吉(キジトラ白の猫)');

// 読者アンケート:いちばん好きな毛柄(この端末だけに保存)
const POLL = [
  { k: 'kiji', t: 'キジトラ', a: { coat: 'brown', pattern: 'tabby', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' } },
  { k: 'chatora', t: '茶トラ', a: { coat: 'red', pattern: 'tabby', eye: 'gold', ears: 'normal', hair: 'short', expr: 'normal' } },
  { k: 'mike', t: '三毛', a: { coat: 'white', pattern: 'calico', eye: 'gold', ears: 'normal', hair: 'short', expr: 'normal' } },
  { k: 'kuro', t: '黒猫', a: { coat: 'black', pattern: 'solid', eye: 'gold', ears: 'normal', hair: 'short', expr: 'normal' } },
  { k: 'hachi', t: 'ハチワレ', a: { coat: 'white', pattern: 'tuxedo', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' } },
  { k: 'saba', t: 'サバトラ', a: { coat: 'silver', pattern: 'tabby', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' } },
] as const;
---
<Base title="ネコキチ猫吉|猫好きは、結局ぜんぶの猫が好き" description="雑種もブランド猫も、短毛も長毛も。猫のウワサを編集部が本気で検証する週刊誌風の猫サイト。人気20種の猫種図鑑、猫種診断、猫の姓名判断、年齢換算・体型チェックなどのツールと、暮らし・健康の目安まで。">
  <section class="front" aria-labelledby="front-h">
        <div class="front-copy">
      <span class="kicker">緊急特集</span>
      <h1 id="front-h">いちばん<br />かわいい猫は<span class="q">？</span></h1>
      <p class="sub-head">編集部、全猫を調べたら<span class="hl">全員だった</span></p>
      <p>キジトラも三毛も黒猫も。スコもマンチカンもメインクーンも、名もなき雑種も。比べようとしたら、全員こっちを見てきた。無理だった。この雑誌は、猫にやられた人たち(ネコキチ)のための、猫の総合誌です。</p>
      <div class="cta">
        <a class="btn btn-pink" href="/breeds/">猫種図鑑を見る</a>
        <a class="btn" href="/tools/match/">猫種診断をやる</a>
      </div>
    </div>
    <div class="front-art" role="img" aria-label="芝生の庭に、いろんな猫が集まっている絵">
      <span class="gogai">きょうは<b>{SCENE.length}匹</b>来ています</span>
      {SCENE.map((c, i) => (
        <span class:list={['spot', c.prop, { boss: c.body }]} style={`left:${c.x}%;top:${c.y}%;width:${c.w}%;--d:${-i * 0.37}s`} title={c.label}>
          {c.prop && <i class="prop" />}
          <Fragment set:html={c.body ? boss : faceSvg(c.a, undefined, true)} />
        </span>
      ))}
    </div>
  </section>

  <section class="verdict" id="verdict" aria-labelledby="verdict-h">
    <span class="stamp" aria-hidden="true">結論</span>
    <div>
      <span class="label">■ 編集部の結論</span>
      <h2 id="verdict-h">いちばんは、<em>うちの子。</em></h2>
      <p>そして、よその子もかわいい。道ばたの子も、動画の子も、図鑑の子も、ぜんぶかわいい。猫好きは、結局ぜんぶの猫が好き。この雑誌はその前提で、猫のウワサを本気で検証し、暮らしと健康の「目安」をまじめにまとめていきます。編集長は猫吉(キジトラ白)。いまキーボードの上で寝ているので、校正は遅れます。</p>
    </div>
    <div class="face" set:html={faceSvg(NEKOKICHI, '得意げな編集長・猫吉', true)} />
  </section>

  <div class="band" id="tools"><span class="no">01</span><h2>占い・診断・ツール</h2></div>
  <div class="tool-grid">
    {TOOLS.map((x) => <a class="tool-card" href={x.href}><span set:html={faceSvg(x.art)} /><span><b>{x.t}</b><small>{x.d}</small></span></a>)}
  </div>

  <div class="band" id="kensho"><span class="no">02</span><h2>猫のウワサ、検証しました</h2></div>
  <p class="lede">ネットや昔から言われている猫のウワサを、編集部が論文や獣医師の解説までさかのぼって調べました。</p>
  <div class="rumors">
    {rumors.map((c) => (
      <a class="rumor rumor-link" href={`/columns/${c.id}/`}>
        <div class="rumor-q"><small>ウワサ</small><h3>{c.data.title.replace(/^【検証】/, '')}</h3></div>
        <div class="rumor-a"><span class={`judge judge-${c.data.verdict.type}`}>{c.data.verdict.label}</span><p>{c.data.verdict.summary}</p><span class="rumor-more">記事を読む →</span></div>
      </a>
    ))}
  </div>
  <p class="more"><a class="btn" href="/columns/#kensho">ウワサ検証をもっと読む</a></p>

  <div class="band" id="breeds"><span class="no">03</span><h2>猫種図鑑:庭に来た猫たち</h2></div>
  <p class="lede">人気の猫種と、雑種。よく言われる性格の「ウワサ」と「実際は個体差」を分けて、特徴・お手入れ・気をつけたい病気までまとめました。</p>
  <div class="wanted-grid">
    {pickup.map((b) => (
      <a class="wanted breed-card" href={`/breeds/${b.slug}/`}>
        <div class="w-title">{b.hair}・{b.size}</div>
        <div class="w-pic" set:html={bodySvg(b.art, `${b.name}のイラスト`)} />
        <h3>{b.name}</h3>
        <span class="crime">{b.catch}</span>
      </a>
    ))}
  </div>
  <p class="more"><a class="btn btn-pink" href="/breeds/">猫種図鑑(全{BREEDS.length}種)を見る</a></p>

  <div class="band" id="jitsuyo"><span class="no">04</span><h2>ここだけ真面目な話:暮らしと健康</h2></div>
  <div class="serious">
    <p class="serious-head"><span>いざというとき</span>かわいいだけで終わらせないために</p>
    <p>おしっこが出ない、口を開けて息をしている、ぐったりしている。猫は具合が悪くても隠しがちなので、「いつもと違う」に気づいたら早めに動物病院へ。夜間に困ったときの探し方も含めて、<a href="/columns/emergency-signs/">すぐ病院へ行くべき症状</a>にまとめました。</p>
  </div>
  <ColumnList items={jitsuyo} />

  <section class="poll" aria-labelledby="poll-h">
    <div class="face" set:html={faceSvg({ ...NEKOKICHI, expr: 'wow' }, '目を見開いた編集長', true)} />
    <div>
      <h2 id="poll-h">読者アンケート:いちばん好きな毛柄は？</h2>
      <p>いちばん近いのを押してください。何回押してもいいです。全部押してもいいです(編集長は全部押しました)。</p>
      <div class="poll-btns">
        {POLL.map((p) => <button class="poll-btn vote" type="button" data-k={p.k}><span set:html={faceSvg(p.a)} />{p.t}</button>)}
      </div>
      <div class="poll-result" aria-live="polite">
        {POLL.map((p) => <div>{p.t}<div class="bar"><i data-bar={p.k}></i><span data-n={p.k}>0</span></div></div>)}
        <small>※この端末で押した回数です。どれを押しても、結局みんな猫が好き。</small>
      </div>
    </div>
  </section>

  <button class="peek" type="button" aria-label="ページの上へ戻る(のぞいている編集長)">
    <span class="say">見た？</span>
    <Fragment set:html={faceSvg(NEKOKICHI, undefined, true)} />
  </button>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const popWord = (x: number, y: number, text: string, spread = 140) => {
      const w = document.createElement('span');
      w.className = 'pop-word';
      w.textContent = text;
      w.style.left = `${x - 30}px`;
      w.style.top = `${y}px`;
      w.style.setProperty('--dx', `${rand(-spread, spread)}px`);
      w.style.setProperty('--dy', `${rand(-150, -60)}px`);
      w.style.setProperty('--r', `${rand(-25, 25)}deg`);
      document.body.appendChild(w);
      w.addEventListener('animationend', () => w.remove());
      return w;
    };

    // 読者アンケート
    const KEYS = [...document.querySelectorAll<HTMLButtonElement>('.vote')].map((b) => b.dataset.k!);
    const counts: Record<string, number> = Object.fromEntries(KEYS.map((k) => [k, 0]));
    try { Object.assign(counts, JSON.parse(localStorage.getItem('nk-poll') ?? '{}')); } catch {}
    const render = () => {
      const max = Math.max(1, ...Object.values(counts));
      for (const k of KEYS) {
        const bar = document.querySelector<HTMLElement>(`[data-bar="${k}"]`);
        const n = document.querySelector<HTMLElement>(`[data-n="${k}"]`);
        if (bar) bar.style.width = `${(counts[k] / max) * 100}%`;
        if (n) n.textContent = String(counts[k]);
      }
    };
    render();
    const WORDS = ['全部かわいい', 'わかる', 'にゃ', '尊い', 'ぜんぶ', 'うちの子!'];
    for (const b of document.querySelectorAll<HTMLButtonElement>('.vote')) {
      b.addEventListener('click', () => {
        counts[b.dataset.k!]++;
        try { localStorage.setItem('nk-poll', JSON.stringify(counts)); } catch {}
        render();
        if (reduce) return;
        const r = b.getBoundingClientRect();
        for (let i = 0; i < 3; i++) {
          const w = popWord(r.left + scrollX + r.width / 2, r.top + scrollY - 10, WORDS[Math.floor(Math.random() * WORDS.length)]);
          w.style.animationDelay = `${i * 60}ms`;
        }
      });
    }

    // 一面の猫:さわると「にゃ」
    const MEOW = ['にゃ', 'にゃーん', 'なに', 'ごはん?', 'ふみふみ', 'ゴロゴロ'];
    for (const g of document.querySelectorAll<HTMLElement>('.spot')) {
      g.addEventListener('click', () => {
        if (reduce) return;
        const r = g.getBoundingClientRect();
        g.querySelector('svg')?.animate([{ translate: '0 0' }, { translate: '0 -18px' }, { translate: '0 0' }], { duration: 380, easing: 'ease-out' });
        popWord(r.left + scrollX + r.width / 2, r.top + scrollY, MEOW[Math.floor(Math.random() * MEOW.length)], 30);
      });
    }

    // 右下からのぞく編集長(一面を過ぎたら出てくる。押すとしゃべって、ページの上へ)
    const peek = document.querySelector<HTMLButtonElement>('.peek');
    const front = document.querySelector('.front');
    if (peek && front) {
      const LINES = ['見た？', '編集長です', 'ぜんぶの猫が好き', 'いま寝てた', '校正は明日'];
      new IntersectionObserver(([e]) => peek.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(front);
      let timer = 0;
      peek.addEventListener('click', () => {
        peek.querySelector('.say')!.textContent = LINES[Math.floor(Math.random() * LINES.length)];
        peek.classList.add('talk');
        clearTimeout(timer);
        timer = window.setTimeout(() => peek.classList.remove('talk'), 1800);
        setTimeout(() => scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }), reduce ? 0 : 450);
      });
    }

    // 何もないところをタップすると、肉球スタンプ
    const PAW = '<svg viewBox="0 0 40 40" aria-hidden="true"><g fill="currentColor" stroke="#1a1410" stroke-width="2"><ellipse cx="20" cy="27" rx="10" ry="8.5"/><ellipse cx="8" cy="16" rx="4.2" ry="5.2"/><ellipse cx="15.5" cy="9" rx="4.2" ry="5.4"/><ellipse cx="24.5" cy="9" rx="4.2" ry="5.4"/><ellipse cx="32" cy="16" rx="4.2" ry="5.2"/></g></svg>';
    document.addEventListener('click', (e) => {
      if (reduce || (e.target as Element).closest('a, button, input, label, svg')) return;
      if (getSelection()?.toString()) return;
      const p = document.createElement('span');
      p.className = 'paw';
      p.innerHTML = PAW;
      p.style.left = `${e.pageX}px`;
      p.style.top = `${e.pageY}px`;
      p.style.rotate = `${rand(-30, 30)}deg`;
      document.body.appendChild(p);
      p.addEventListener('animationend', () => p.remove());
    });
  </script>

  <style>
    .spot { position: absolute; cursor: pointer; }
    .spot svg { position: relative; width: 100%; }
    .spot .prop { position: absolute; left: -6%; right: -6%; bottom: -6%; height: 26%; border: 2px solid var(--k); }
    .spot.zabu .prop { background: var(--zabu); border-radius: 40%; }
    .spot.box .prop { background: #d9b07a; border-radius: 4px; height: 40%; bottom: -16%; }
    .spot.box .prop::after { content: ""; position: absolute; left: 10%; right: 10%; top: 28%; border-top: 2px dashed var(--wood-dark); }
    .spot.boss { z-index: 2; }
    .rumor-link { color: var(--k); text-decoration: none; transition: translate .1s, box-shadow .1s; }
    .rumor-link:hover { color: var(--k); translate: -2px -2px; box-shadow: 8px 8px 0 var(--k); }
    .rumor-more { display: block; margin-top: 8px; font-weight: 900; font-size: .85rem; color: var(--blue); }
    .serious { margin-bottom: 18px; }
    .poll-btns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 10px 0 14px; }
    .poll-btn { display: grid; grid-template-columns: 40px 1fr; align-items: center; gap: 6px; font: inherit; font-family: var(--font-head); font-size: .98rem; text-align: left; padding: 6px 10px; border: 2px solid var(--k); border-radius: 12px; background: var(--white); box-shadow: 0 3px 0 var(--wood-dark); cursor: pointer; color: var(--k); }
    .poll-btn:active { translate: 0 2px; box-shadow: 0 1px 0 var(--wood-dark); }
    .poll-btn svg { width: 100%; }
    @media (max-width: 560px) { .poll-btns { grid-template-columns: repeat(2, minmax(0, 1fr)); } .front-art { min-height: 300px; } .gogai { font-size: .85rem; } }
    @media (prefers-reduced-motion: no-preference) {
      .spot svg { animation: bob 3s ease-in-out infinite; animation-delay: var(--d); transform-origin: 50% 100%; }
      .spot.boss svg { animation: none; }
      @keyframes bob { 50% { translate: 0 -4px; } }
      .boss .tail { transform-box: view-box; transform-origin: 162px 272px; animation: tail-sway 2.4s ease-in-out infinite; }
    }
  </style>
</Base>
