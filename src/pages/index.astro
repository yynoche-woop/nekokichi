---
// トップページ。構成は「猫砂のかけあい」の町:ステージ → コーナー選択 → ネコキチニュース → 猫砂フェス → ずかん → 真面目な話。
// (週刊ラグドールの「一面→結論→ウワサ→指名手配→アンケート」構成は使わない。横田さん 2026-09-27)
import Base from '../layouts/Base.astro';
import { getColumns } from '../lib';
import { BREEDS } from '../data/breeds';
import { faceSvg, bodySvg, kickCatSvg, NEKOKICHI } from '../data/cat-art';
import { sandSvg, sandPile } from '../data/splat';
import type { Art } from '../data/art-schema';

const all = await getColumns();
const shuusei = all.filter((c) => c.data.category === 'shuusei');
const jitsuyo = all.filter((c) => c.data.category === 'jitsuyo');

const MIKE: Art = { coat: 'white', pattern: 'calico', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' };
const KURO: Art = { coat: 'black', pattern: 'solid', eye: 'gold', ears: 'normal', hair: 'short', expr: 'wow' };
const SABA: Art = { coat: 'silver', pattern: 'tabby', eye: 'green', ears: 'normal', hair: 'short', expr: 'normal' };
const RAG: Art = { coat: 'seal', pattern: 'mitted', eye: 'blue', ears: 'normal', hair: 'semi', expr: 'smug' };

// コーナー選択(ななめのタイル)
const STAGES = [
  { href: '/breeds/', t: 'なかま図鑑', n: `${BREEDS.length}種`, d: '長毛も短毛も雑種も。みんな<span class="nw">なかま</span>。', art: SABA, c: 'y' },
  { href: '/columns/#shuusei', t: '猫の習性事典', n: `${shuusei.length}項目`, d: '箱、ゴロゴロ、ふみふみ。猫のふしぎを研究から調べた。', art: KURO, c: 'v' },
  { href: '/tools/', t: 'あそび', n: '5つ', d: '人間用。猫種診断・名前うらない・年齢換算。', art: MIKE, c: 'm' },
  { href: '/columns/#jitsuyo', t: '下僕<wbr>マニュアル', n: `${jitsuyo.length}本`, d: '暮らしと健康。下僕は必ず読むこと。', art: RAG, c: 'p' },
];

// ネコキチニュース:MCふたり(編集長・猫吉と、三毛のミケ子)が最新記事を紹介する
const OPEN = ['速報です!', 'ニュースです!', '聞いてください!', '大変です!', '号外です!', '続報!'];
const NEWS = shuusei.slice(0, 6).map((c, i) => ({
  href: `/columns/${c.id}/`,
  a: `${OPEN[i % OPEN.length]} ${c.data.title.replace(/[::].*$/, '').replace(/ .*$/, '')}`,
  b: c.data.verdict.summary,
}));

// 猫砂フェス:3つの陣営
const FES = [
  { k: 'kouseki', t: '鉱物系', d: 'ずっしり固まる、ベントナイトの民', color: '#e6ff2e' },
  { k: 'kami', t: '紙・木系', d: '軽くて流せる、ペレットの民', color: '#16e0b0' },
  { k: 'okara', t: 'おから系', d: 'ちょっといい匂い、豆腐の民', color: '#ff3ea5' },
];

const pickup = ['american-shorthair', 'ragdoll', 'singapura', 'tonkinese', 'persian', 'mix', 'maine-coon', 'russian-blue'] // 図鑑と同じ並び:アメショ・ラグドールのあとはあいうえお順
  .map((s) => BREEDS.find((b) => b.slug === s))
  .filter((b) => b !== undefined);
---
<Base title="ネコキチ猫吉|猫好きは、結局ぜんぶの猫が好き" description="雑種も純血種も、短毛も長毛も。猫の習性と全猫種を、研究や獣医師の解説からまとめる猫サイト。36種の猫種ずかん、猫種診断、猫の姓名判断、年齢換算・体型チェックのツールと、暮らし・健康の目安まで。">

  <!-- 1. ステージ:巨大な編集長が、砂をかけている -->
  <section class="stage" aria-labelledby="stage-h">
    <div class="stage-sand">
      <Fragment set:html={sandSvg(55, ['#16e0b0', '#e6ff2e'], 's3')} />
    </div>
    <div class="stage-copy">
      <p class="stage-kicker">猫が作っている、猫のメディア</p>
      <h1 id="stage-h"><span>ネコキチ</span><span>猫吉</span></h1>
      <p class="stage-sticker">猫好きは、結局ぜんぶの猫が好き。</p>
      <p class="stage-lead">このサイトは、猫が作っています。人間のみなさんは、読むだけでいいです。猫のしぐさや体のふしぎは、猫が論文までさかのぼって調べました。下僕向けの暮らしと健康の注意書きは、まじめに書きました。キジトラも三毛も黒猫も、長毛も雑種も、みんな<span class="nw">なかま</span>です。ｆｆｆｆｆｆｆｇｇｇｇ<small class="mash-note">(編集長がキーボードの上を歩きました)</small></p>
      <p class="hair-note">画面に落ちている猫の毛は、左下のコロコロで取れます。換毛期なので、またすぐ抜けます。</p>
      <div class="cta">
        <a class="btn btn-pink" href="/breeds/">なかま図鑑を見る</a>
        <a class="btn" href="/tools/match/">猫種診断をやる</a>
      </div>
    </div>
    <div class="stage-art">
      <svg class="pile" viewBox="0 0 200 100" aria-hidden="true"><path d={sandPile(8)} fill="#e9d6b0" /><path d={sandPile(9)} fill="#e6ff2e" transform="translate(40 30) scale(.6 .7)" /></svg>
      <button class="boss" type="button" id="boss" data-f="0" aria-label="編集長の猫吉。押すと砂をかける">
        <Fragment set:html={kickCatSvg(NEKOKICHI, '後ろ足で砂をかけている編集長の猫吉(キジトラ白の猫)')} />
      </button>
      <span class="rival r1" set:html={faceSvg(MIKE, '三毛猫', true)} />
      <span class="rival r2" set:html={faceSvg(KURO, '黒猫', true)} />
      <span class="boss-say" id="boss-say">押すと砂をかけます</span>
    </div>
  </section>

  <!-- 2. コーナー選択 -->
  <div class="band"><span class="no">SELECT</span><h2>どこであそぶ?</h2></div>
  <div class="stages">
    {STAGES.map((s) => (
      <a class={`stile t-${s.c} pop-in`} href={s.href}>
        <span class="stile-art" set:html={faceSvg(s.art)} />
        <span class="stile-n">{s.n}</span>
        <b set:html={s.t} />
        <small set:html={s.d} />
      </a>
    ))}
  </div>

  <!-- 3. ネコキチニュース -->
  <div class="band"><span class="no">NEWS</span><h2>ネコキチニュース</h2></div>
  <section class="news pop-in" aria-label="ネコキチニュース">
    <div class="news-screen">
      <div class="mc mc-a"><span set:html={faceSvg(NEKOKICHI, '編集長の猫吉')} /><small>編集長 猫吉</small></div>
      <div class="news-talk" aria-live="polite">
        <p class="bubble ba" id="news-a">{NEWS[0].a}</p>
        <p class="bubble bb" id="news-b">{NEWS[0].b}</p>
      </div>
      <div class="mc mc-b"><span set:html={faceSvg({ ...MIKE, expr: 'smug' }, '三毛のミケ子')} /><small>記者 ミケ子</small></div>
    </div>
    <div class="news-ctrl">
      <a class="btn btn-pink" id="news-link" href={NEWS[0].href}>この記事を読む</a>
      <button class="btn" type="button" id="news-next">次のニュース</button>
      <span class="news-count" id="news-count">1 / {NEWS.length}</span>
    </div>
    <script type="application/json" id="news-data" set:html={JSON.stringify(NEWS)} />
  </section>

  <!-- 4. 猫砂フェス -->
  <div class="band"><span class="no">FES</span><h2>猫砂フェス:下僕はどの砂を買うべき?</h2></div>
  <section class="fes pop-in" aria-labelledby="fes-h">
    <p id="fes-h" class="fes-lead">猫が投票します。人間も押していい。押した陣営の砂で、トイレが埋まっていく。なお猫は、どの砂でもだいたい一回は文句を言う。</p>
    <div class="fes-box" id="fes-box" aria-hidden="true"></div>
    <div class="fes-teams">
      {FES.map((f) => (
        <button class="fes-btn" type="button" data-k={f.k} data-color={f.color} style={`--c:${f.color}`}>
          <b>{f.t}</b><small>{f.d}</small><span class="fes-pct" data-p={f.k}>0%</span>
        </button>
      ))}
    </div>
    <p class="small fes-note">※この端末で押した回数です。猫砂選びの本当のコツは、猫が気に入るかどうか。変えるときは少しずつ混ぜて。</p>
  </section>

  <!-- 5. ずかん -->
  <div class="band"><span class="no">ZUKAN</span><h2>なかま図鑑:集めたくなる{BREEDS.length}種</h2></div>
  <div class="wanted-grid">
    {pickup.map((b, i) => (
      <a class="wanted breed-card pop-in" href={`/breeds/${b.slug}/`} data-art={JSON.stringify(b.art)} data-name={b.name}>
        <div class="w-title">No.{String(BREEDS.indexOf(b) + 1).padStart(2, '0')} {b.hair}・{b.size}</div>
        <div class="w-pic"><Fragment set:html={sandSvg(100 + i, i % 2 ? ['#6c3cff', '#e9d6b0'] : ['#e6ff2e', '#e9d6b0'])} /><Fragment set:html={bodySvg(b.art, `${b.name}のイラスト`)} /></div>
        <h3>{b.name}</h3>
        <span class="crime">{b.catch}</span>
      </a>
    ))}
  </div>
  <p class="more"><a class="btn btn-pink" href="/breeds/">ぜんぶ見る({BREEDS.length}種)</a></p>

  <!-- 6. 真面目な話 -->
  <section class="calm" aria-labelledby="calm-h">
    <p class="calm-tag">砂かけはここまで</p>
    <h2 id="calm-h">下僕への注意書き(ここだけ真面目)</h2>
    <p>猫は、具合が悪くても隠します。プライドがあるので。だから下僕が気づいてください。おしっこが出ない、口を開けて息をしている、ぐったりしている。「いつもと違う」と思ったら、早めに動物病院へ。</p>
    <ul class="calm-list">
      {jitsuyo.map((c) => <li><a href={`/columns/${c.id}/`}>{c.data.title}</a><span>{c.data.verdict.label.replace(/^結論:/, '')}</span></li>)}
    </ul>
  </section>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const kick = (window as any).nkKick as ((x: number, y: number, dir: number, n?: number) => void) | undefined;

    // 編集長を押すと砂をかける。ひとことしゃべる
    const boss = document.getElementById('boss')!;
    const say = document.getElementById('boss-say')!;
    const LINES = ['くらえ!', '砂かけます', 'ここ、ぼくのトイレ', 'ぜんぶの猫が好き', '編集長です', 'シャッシャッ'];
    let n = 0;
    // 砂かけ:手描きのポーズを切り替える(かまえ→手前の足でけり→かまえ→奥の足でけり…)。
    // 足を付け根で回すと機械っぽいので、コマを step で差し替える。けったコマの足先から砂を後ろ(右)へ飛ばす
    let busy = false;
    const SEQ = [1, 0, 2, 0, 1, 0, 2, 0];
    const bossKick = () => {
      if (reduce || busy) return;
      busy = true;
      SEQ.forEach((f, k) => setTimeout(() => {
        boss.dataset.f = String(f);
        if (f && kick) {
          const t = boss.querySelector(`.kf${f} .toe`)!.getBoundingClientRect();
          kick(t.left + scrollX + t.width / 2, t.top + scrollY + t.height / 2, 1, 26, 1.9);
        }
        if (k === SEQ.length - 1) busy = false;
      }, k * 150));
    };
    boss.addEventListener('click', () => { say.textContent = LINES[n++ % LINES.length]; bossKick(); });
    // 見えているあいだは、ときどき勝手に砂をかける
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(boss);
    setTimeout(bossKick, 800);
    setInterval(() => { if (visible && !document.hidden) bossKick(); }, 5200);

    // ネコキチニュース
    const NEWS: { href: string; a: string; b: string }[] = JSON.parse(document.getElementById('news-data')!.textContent!);
    const home = document.querySelector<HTMLAnchorElement>('.brand')!.getAttribute('href')!.replace(/\/$/, '');
    let i = 0;
    const show = () => {
      const x = NEWS[i];
      const a = document.getElementById('news-a')!, b = document.getElementById('news-b')!;
      a.textContent = x.a; b.textContent = x.b;
      (document.getElementById('news-link') as HTMLAnchorElement).href = home + x.href;
      document.getElementById('news-count')!.textContent = `${i + 1} / ${NEWS.length}`;
      if (reduce) return;
      a.animate([{ scale: .6, opacity: 0 }, { scale: 1.05, opacity: 1 }, { scale: 1 }], { duration: 350, easing: 'ease-out' });
      b.animate([{ scale: .6, opacity: 0 }, { scale: .6, opacity: 0, offset: .4 }, { scale: 1.05, opacity: 1 }, { scale: 1 }], { duration: 650, easing: 'ease-out' });
    };
    document.getElementById('news-next')!.addEventListener('click', () => { i = (i + 1) % NEWS.length; show(); });

    // 猫砂フェス:押した陣営の砂が、トイレに積もる
    const box = document.getElementById('fes-box')!;
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.fes-btn')];
    const counts: Record<string, number> = Object.fromEntries(btns.map((b) => [b.dataset.k!, 0]));
    try { Object.assign(counts, JSON.parse(localStorage.getItem('nk-fes') ?? '{}')); } catch {}
    const colorOf: Record<string, string> = Object.fromEntries(btns.map((b) => [b.dataset.k!, b.dataset.color!]));
    const render = () => {
      const total = Object.values(counts).reduce((a, b) => a + b, 0);
      for (const b of btns) b.querySelector('.fes-pct')!.textContent = `${total ? Math.round((counts[b.dataset.k!] / total) * 100) : 0}%`;
      let acc = 0;
      const stops = Object.entries(counts).filter(([, v]) => v > 0).map(([k, v]) => { const a0 = acc; acc += (v / total) * 100; return `${colorOf[k]} ${a0}% ${acc}%`; });
      box.style.setProperty('--fill', total ? `linear-gradient(90deg, ${stops.join(', ')})` : 'none');
      box.style.setProperty('--h', `${Math.min(100, 12 + total * 4)}%`);
    };
    render();
    for (const b of btns) {
      b.addEventListener('click', () => {
        counts[b.dataset.k!]++;
        try { localStorage.setItem('nk-fes', JSON.stringify(counts)); } catch {}
        render();
        if (reduce || !kick) return;
        const r = b.getBoundingClientRect();
        kick(r.left + scrollX + r.width / 2, r.top + scrollY, Math.random() < .5 ? 1 : -1, 18);
      });
    }
  </script>

  <style>
    /* ステージ */
    .stage { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; gap: 10px; align-items: end; min-height: 520px; margin-top: 18px; }
    .stage-sand { position: absolute; inset: 0; pointer-events: none; }
    .stage-sand :global(.s3) { width: 26%; right: -4%; bottom: 30%; rotate: -10deg; }
    .pile { position: absolute; right: -6%; bottom: -14px; width: min(56%, 360px); z-index: 0; }
    .stage-copy { position: relative; z-index: 2; padding-bottom: 30px; color: var(--white); }
    .stage-kicker { display: inline-block; margin: 0; background: var(--mint); color: var(--k); font-weight: 800; font-size: .85rem; padding: 0 12px; rotate: -3deg; }
    .stage h1 { display: grid; font-family: var(--font-logo); font-size: clamp(3.4rem, 11vw, 7.6rem); line-height: .95; margin: 14px 0 10px; }
    .stage h1 span:first-child { color: var(--yellow); -webkit-text-stroke: 3px var(--k); paint-order: stroke fill; text-shadow: 6px 6px 0 var(--violet); rotate: -4deg; transform-origin: left; }
    .stage h1 span:last-child { color: var(--white); -webkit-text-stroke: 3px var(--k); paint-order: stroke fill; text-shadow: 6px 6px 0 var(--pink); margin-left: .6em; rotate: 3deg; }
    .stage-sticker { display: inline-block; margin: 6px 0 14px; background: var(--white); color: var(--k); font-family: var(--font-head); font-size: clamp(1rem, 2.4vw, 1.3rem); padding: 4px 16px; rotate: -2deg; box-shadow: 4px 4px 0 var(--yellow); }
    .stage-lead { max-width: 34em; margin: 0 0 20px; color: #e9e4f5; }
    .hair-note { display: inline-block; margin: -8px 0 18px; padding: 2px 12px; background: rgba(233, 214, 176, .14); border: 2px dashed var(--sand); color: var(--sand); font-size: .82rem; font-weight: 700; }
    .mash-note { display: block; font-size: .78rem; color: var(--hair); }
    .stage-art { position: relative; z-index: 1; align-self: stretch; min-height: 420px; }
    .boss { position: absolute; right: 8%; bottom: 0; width: min(104%, 540px); background: none; border: 0; padding: 0; cursor: pointer; }
    .boss svg { width: 100%; filter: drop-shadow(2.5px 0 0 #fff) drop-shadow(-2.5px 0 0 #fff) drop-shadow(0 2.5px 0 #fff) drop-shadow(0 -2.5px 0 #fff); }
    /* コマ切り替え:data-f のコマだけ見せる */
    .boss :global(.kf) { display: none; }
    .boss[data-f="0"] :global(.kf0), .boss[data-f="1"] :global(.kf1), .boss[data-f="2"] :global(.kf2) { display: inline; }
    .boss[data-f="1"] > :global(svg), .boss[data-f="2"] > :global(svg) { translate: 0 3px; }
    .rival { position: absolute; width: 26%; }
    .rival.r1 { left: 34%; top: 0; width: 22%; rotate: -12deg; }
    .rival.r2 { right: -2%; top: 0; width: 22%; rotate: 10deg; }
    .boss-say { position: absolute; left: -2%; bottom: 52%; background: var(--yellow); color: var(--k); font-family: var(--font-head); padding: 4px 14px; border: 3px solid var(--k); rotate: -6deg; white-space: nowrap; }
    @media (max-width: 800px) {
      .stage { grid-template-columns: 1fr; min-height: 0; }
      .stage-art { order: -1; min-height: 330px; }
      .boss { width: 84%; right: 14%; }
      .boss-say { bottom: 78%; left: 0; }
      .stage-sand :global(.s3) { display: none; }
      .stage-copy { padding-bottom: 0; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .stage h1 span { animation: slam .6s cubic-bezier(.3, 1.6, .5, 1) both; }
      .stage h1 span:last-child { animation-delay: .15s; }
      @keyframes slam { from { opacity: 0; scale: 2.2; } }
      .stage-sand :global(.splat) { animation: sand-in .7s cubic-bezier(.2, 1.4, .5, 1) both; }
      .stage-sand :global(.s3) { animation-delay: .3s; }
      @keyframes sand-in { from { opacity: 0; scale: .2; } }
      .rival { animation: peek 3s ease-in-out infinite; }
      .rival.r2 { animation-delay: -1.4s; }
      @keyframes peek { 50% { translate: 0 -10px; } }
    }

    /* コーナー選択:ななめのタイル */
    .stages { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .stile { position: relative; display: grid; align-content: end; gap: 2px; min-height: 250px; padding: 18px; color: var(--k); text-decoration: none; border: 3px solid var(--k); clip-path: polygon(0 4%, 100% 0, 100% 96%, 0 100%); overflow: hidden; transition: translate .15s, rotate .15s; }
    .stile:hover { translate: 0 -6px; rotate: -1deg; color: var(--k); }
    .t-y { background: var(--yellow); } .t-v { background: var(--violet); color: var(--white); } .t-m { background: var(--mint); } .t-p { background: var(--pink); color: var(--white); }
    .t-v:hover, .t-p:hover { color: var(--white); }
    .stile-art { position: absolute; right: -10px; top: 8px; width: 62%; rotate: 8deg; transition: rotate .2s, scale .2s; }
    .stile:hover .stile-art { rotate: -4deg; scale: 1.08; }
    .stile-n { position: relative; font-family: var(--font-latin); font-size: .9rem; }
    .stile b { position: relative; font-family: var(--font-head); font-weight: 900; font-size: 1.6rem; line-height: 1.2; }
    .stile small { position: relative; font-size: .82rem; font-weight: 700; line-height: 1.5; }
    .nw { white-space: nowrap; }
    @media (max-width: 860px) {
      .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .stile { min-height: 0; padding: 14px; padding-top: calc(52% + 14px); }
      .stile-art { width: 54%; right: 4px; top: 10px; }
      .stile b { font-size: clamp(1.15rem, 5.6vw, 1.6rem); }
    }

    /* ネコキチニュース */
    .news { background: var(--night-2); border: 3px solid var(--k); box-shadow: 8px 8px 0 var(--yellow); padding: 18px; }
    .news-screen { display: grid; grid-template-columns: 130px 1fr 130px; gap: 12px; align-items: end; }
    .mc { text-align: center; color: var(--white); font-weight: 800; font-size: .78rem; }
    .mc span { display: block; }
    .mc-a span { rotate: -6deg; } .mc-b span { rotate: 6deg; }
    .news-talk { display: grid; gap: 12px; align-self: center; }
    .bubble { position: relative; margin: 0; padding: 10px 16px; border: 3px solid var(--k); font-weight: 800; line-height: 1.6; }
    .ba { background: var(--yellow); justify-self: start; rotate: -1deg; }
    .bb { background: var(--white); justify-self: end; rotate: 1deg; font-weight: 700; }
    .news-ctrl { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 16px; }
    .news-count { font-family: var(--font-latin); color: var(--hair); }
    @media (max-width: 640px) {
      .news-screen { grid-template-columns: 1fr 1fr; }
      .news-talk { grid-column: 1 / -1; grid-row: 1; }
      .mc { width: 90px; } .mc-b { justify-self: end; }
    }

    /* 猫砂フェス */
    .fes { background: var(--paper); border: 3px solid var(--k); box-shadow: 8px 8px 0 var(--mint); padding: 20px; }
    .fes-lead { margin: 0 0 14px; font-weight: 700; }
    .fes-box { position: relative; height: 150px; border: 4px solid var(--k); border-top: 0; border-radius: 0 0 26px 26px; background: #f1ecff; overflow: hidden; }
    .fes-box::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: var(--h, 12%); background: var(--fill, var(--sand)); transition: height .5s cubic-bezier(.3, 1.4, .5, 1); }
    .fes-teams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; }
    .fes-btn { display: grid; gap: 2px; text-align: left; font: inherit; padding: 12px 14px; background: var(--c); color: var(--k); border: 3px solid var(--k); box-shadow: 4px 4px 0 var(--k); cursor: pointer; transition: translate .1s, box-shadow .1s; }
    .fes-btn:active { translate: 3px 3px; box-shadow: 1px 1px 0 var(--k); }
    .fes-btn b { font-family: var(--font-head); font-weight: 900; font-size: 1.3rem; }
    .fes-btn small { font-weight: 700; font-size: .8rem; }
    .fes-pct { font-family: var(--font-latin); font-size: 1.4rem; }
    .fes-note { margin: 12px 0 0; }
    @media (max-width: 640px) { .fes-teams { grid-template-columns: 1fr; } }

    /* 真面目な話 */
    .calm { margin-top: 80px; background: var(--paper); border: 3px solid var(--k); padding: 22px 24px; box-shadow: 8px 8px 0 var(--sand); }
    .calm-tag { display: inline-block; margin: 0; background: var(--sand); padding: 0 12px; font-weight: 800; font-size: .85rem; }
    .calm h2 { font-size: clamp(1.4rem, 3.4vw, 2rem); margin: 8px 0 8px; }
    .calm-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
    .calm-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 10px 0; border-top: 2px dashed var(--hair); }
    .calm-list a { font-weight: 800; color: var(--k); }
    .calm-list span { font-size: .85rem; color: var(--gray); }
  </style>
</Base>
