---
import Base from '../../layouts/Base.astro';
import { BREEDS } from '../../data/breeds';
import { bodySvg } from '../../data/cat-art';

const FILTERS = [
  { k: 'all', t: 'ぜんぶ' },
  { k: 'short', t: '短毛' },
  { k: 'long', t: '長毛・セミロング' },
  { k: 'big', t: '大きめ' },
  { k: 'small', t: '小さめ' },
];
const tags = (b: (typeof BREEDS)[number]) =>
  [
    b.hair.includes('短毛') || b.hair === '無毛' ? 'short' : '',
    b.hair.includes('長毛') || b.hair === 'セミロング' ? 'long' : '',
    b.size === '大型' ? 'big' : '',
    b.size === '小型' ? 'small' : '',
  ].filter(Boolean).join(' ');
---
<Base title="猫種図鑑:人気の猫20種の性格・特徴・お手入れ|ネコキチ猫吉" description="スコティッシュフォールド、マンチカン、アメショ、ラグドール、メインクーン、そして雑種まで。人気の猫20種の特徴・よく聞くウワサの真偽・お手入れ・気をつけたい病気を、編集部がまとめた猫種図鑑。">
  <nav class="crumb"><a href="/">トップ</a> › 猫種図鑑</nav>
  <div class="band"><span class="no">図鑑</span><h1>猫種図鑑:庭に来た猫たち</h1></div>
  <p class="lede">人気の猫種と、雑種(ミックス)。性格は「よく言われる」だけで、実際はどの子も個体差です。そして全員かわいいので、編集部は比べるのをあきらめました。</p>
  <div class="bfilter" role="group" aria-label="しぼりこみ">
    {FILTERS.map((f, i) => <button type="button" class:list={['btn', { on: i === 0 }]} data-f={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.t}</button>)}
  </div>
  <div class="wanted-grid breed-grid">
    {BREEDS.map((b) => (
      <a class="wanted breed-card" href={`/breeds/${b.slug}/`} data-tags={tags(b)}>
        <div class="w-title">{b.hair}・{b.size}</div>
        <div class="w-pic" set:html={bodySvg(b.art, `${b.name}のイラスト`)} />
        <h3>{b.name}</h3>
        <span class="crime">{b.catch}</span>
      </a>
    ))}
  </div>
  <p class="more"><a class="btn btn-pink" href="/tools/match/">迷ったら猫種診断</a></p>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.bfilter button');
    const cards = document.querySelectorAll<HTMLElement>('.breed-card');
    for (const b of btns) {
      b.addEventListener('click', () => {
        const f = b.dataset.f!;
        for (const x of btns) { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); }
        for (const c of cards) c.hidden = f !== 'all' && !(c.dataset.tags ?? '').split(' ').includes(f);
      });
    }
  </script>
</Base>
