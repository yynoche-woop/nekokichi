---
import Base from '../../layouts/Base.astro';
import { BREEDS, type Breed } from '../../data/breeds';
import { faceSvg } from '../../data/cat-art';
import { sandSvg } from '../../data/splat';

export function getStaticPaths() {
  return BREEDS.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}
interface Props { b: Breed }
const { b } = Astro.props;
const i = BREEDS.findIndex((x) => x.slug === b.slug);
const next = [...BREEDS.slice(i + 1), ...BREEDS.slice(0, i)].slice(0, 4);
const others = BREEDS.filter((x) => x.slug !== b.slug);
const T = [
  { k: 'play', t: '活発さ', lo: 'のんびり', hi: '運動会' },
  { k: 'cuddle', t: '甘えたがり', lo: 'ひとり好き', hi: 'べったり' },
  { k: 'voice', t: 'おしゃべり', lo: '無口', hi: 'よくしゃべる' },
  { k: 'groom', t: 'お手入れの手間', lo: 'ラク', hi: 'たいへん' },
  { k: 'size', t: '体の大きさ', lo: '小さめ', hi: 'でかい' },
] as const;
// 寿命は数字を書かず、ひとことをランダムに(横田さん 2026-10-02)。ページごとに決めておき、開くたびに入れかえる
const LIFE_ALL = ['長生きしてね。', '永遠。', '猫又になるかも。', '猫又になる(多分)。', '氷河期が来るまで。', '一生死にません。', '天使の類に寿命はない。', '神様の類に寿命はない。', 'そんなことより、可愛い。'];
// 猫種だけのひとこと(出やすくするため2回入れる)
const LIFE_BREED: Record<string, string> = {
  'american-shorthair': 'アメリカンロングライフ。',
  'exotic-shorthair': 'エキゾチックロングライフ。',
  'british-shorthair': 'ブリティッシュロングライフ。',
  'british-longhair': 'ブリティッシュロングライフ。',
  abyssinian: 'アビ死なへん。',
};
const own = LIFE_BREED[b.slug];
const LIFE = own ? [own, own, ...LIFE_ALL] : LIFE_ALL;
const title = `${b.name}の性格・特徴・お手入れ|猫種図鑑|ネコキチ猫吉`;
const description = `${b.name}(${b.en})ってどんな猫?${b.lead.slice(0, 70)}…特徴、よくある誤解、お手入れ、気をつけたい病気まで。`;
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: `${b.name}の性格・特徴・お手入れ`, author: { '@type': 'Organization', name: 'ネコキチ編集部' } };
---
<Base title={title} description={description} jsonld={jsonld}>
  <script>
    const w = document.querySelector<HTMLElement>('.life-word');
    if (w) { const l: string[] = JSON.parse(w.dataset.words!); w.textContent = l[Math.floor(Math.random() * l.length)]; }
  </script>
  <nav class="crumb"><a href="/">トップ</a> › <a href="/breeds/">猫種図鑑</a> › {b.name}</nav>
  <article class="col-article">
    <header class="col-head">
      <Fragment set:html={sandSvg(i * 13 + 5, ['#16e0b0', '#ff3ea5'])} />
      <div class="col-head-copy">
        <span class="kicker">猫種図鑑 No.{String(i + 1).padStart(2, '0')}</span>
        <h1>{b.name}<small class="b-en">{b.en}{b.nick && ` / 通称「${b.nick}」`}</small></h1>
        <p class="b-catch">{b.catch}</p>
      </div>
      <div class="col-head-art" set:html={faceSvg(b.art, `${b.name}の顔のイラスト`, true)} />
    </header>
    <div class="prose">
      <p class="b-lead">{b.lead}</p>
      <table class="b-spec">
        <tbody>
          <tr><th scope="row">原産・発祥</th><td>{b.origin}</td></tr>
          <tr><th scope="row">毛の長さ</th><td>{b.hair}</td></tr>
          <tr><th scope="row">大きさ</th><td>{b.size}</td></tr>
          <tr><th scope="row">体重</th><td>{b.weight}</td></tr>
          <tr><th scope="row">寿命</th><td><span class="life-word" data-words={JSON.stringify(LIFE)}>{own ?? LIFE[[...b.slug].reduce((n, ch) => n + ch.charCodeAt(0), 0) % LIFE.length]}</span><small class="b-life">寿命は一匹ずつの体質や暮らし方でも大きく変わります。猫全体の平均は14歳前後(アニコムの集計)。<a href="/tools/age/">猫の年齢換算</a></small></td></tr>
        </tbody>
      </table>

      <h2>確かな特徴</h2>
      <div class="evidence">
        {b.features.map((f) => <article class="ev"><h3>{f.t}</h3><p>{f.d}</p></article>)}
      </div>

      {b.coats && (
        <>
          <h2>毛色と模様の呼び名</h2>
          <table class="b-coats">
            <thead><tr><th scope="col">呼び名</th><th scope="col">どんな毛色・模様?</th></tr></thead>
            <tbody>{b.coats.map((c) => <tr><th scope="row">{c.t}</th><td>{c.d}</td></tr>)}</tbody>
          </table>
          <p class="small">ほかの猫種にも出てくる呼び名(タビー・ポイントなど)は、<a href="/columns/coat-patterns/">猫の毛色と模様の呼び名</a>にまとめています。</p>
        </>
      )}

      <h2>よく言われる傾向</h2>
      <div class="tend">
        {T.map((t) => (
          <div class="tend-row">
            <span class="tend-t">{t.t}</span>
            <span class="tend-lo">{t.lo}</span>
            <span class="tend-bar" role="img" aria-label={`5段階中${b.tendency[t.k]}`}>{[1, 2, 3, 4, 5].map((n) => <i class:list={{ on: n <= b.tendency[t.k] }} />)}</span>
            <span class="tend-hi">{t.hi}</span>
          </div>
        ))}
      </div>
      <p class="small">※紹介でよく言われる傾向を編集部が5段階にしたもの。性格は同じ猫種でも一匹ずつちがいます。</p>

      <h2>よくある誤解</h2>
      <div class="myths">
        {b.myths.map((r) => (
          <article class="myth">
            <div class="myth-q"><small>よく言われること</small><h3>{r.q}</h3></div>
            <div class="myth-a"><span class={`judge judge-${r.j}`}>{r.label}</span><p>{r.a}</p></div>
          </article>
        ))}
      </div>

      <h2>暮らし・お手入れのポイント</h2>
      <ul>{b.care.map((c) => <li>{c}</li>)}</ul>

      <h2>気をつけたい病気</h2>
      <div class="serious">
        <p>{b.health}</p>
        <p class="small">※一般的な情報です。個体差があります。健康のことは、かかりつけの獣医師に相談してください。</p>
      </div>

      <aside class="col-verdict b-tsukkomi">
        <span class="label">編集部のひとこと</span>
        <p>{b.tsukkomi}</p>
      </aside>
    </div>
    {b.sources.length > 0 && (
      <section class="col-sources">
        <h2>編集部が見た資料</h2>
        <ul>{[...b.sources, ...(b.coatsSources ?? [])].map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul>
      </section>
    )}
  </article>

  <h2 class="sub-band">ほかの猫種も見る(全員かわいい)</h2>
  <div class="tool-grid">
    {next.map((x) => <a class="tool-card" href={`/breeds/${x.slug}/`}><span set:html={faceSvg(x.art)} /><span><b>{x.name}</b><small>{x.catch}</small></span></a>)}
  </div>
  <p class="back"><a class="btn" href="/breeds/">猫種図鑑(全{BREEDS.length}種)へ</a> <a class="btn btn-pink" href="/tools/match/">猫種診断をやる</a></p>
  <p class="small b-others">ほかに掲載中:{others.map((x, n) => <>{n > 0 && '・'}<a href={`/breeds/${x.slug}/`}>{x.name}</a></>)}</p>
</Base>
